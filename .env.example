NODE_ENV=production
PORT=3000

# Генерировать командой: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# Путь к SQLite базе данных
SQLITE_STORAGE=/var/www/usta/usta_db.sqlite

# Разрешённые домены (через запятую, без пробелов)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
